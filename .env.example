# WBJDBC Optimized Configuration
# Copy this file to .env and configure your settings

# ========================================
# Database Connection Settings
# ========================================
WBJDBC_DB_HOST=localhost
WBJDBC_DB_PORT=1526
WBJDBC_DB_NAME=mydb
WBJDBC_DB_USER=myuser
WBJDBC_DB_PASSWORD=mypassword
WBJDBC_DB_SERVER=informix_server  # Required for Informix

# ========================================
# Connection Pool Settings
# ========================================
# Initial pool size (number of connections created at startup)
WBJDBC_POOL_SIZE=10

# Maximum pool size (max number of connections)
WBJDBC_POOL_MAX_SIZE=20

# Connection checkout timeout in seconds
WBJDBC_POOL_TIMEOUT=30.0

# Connection recycle time in seconds (reconnect after this time)
WBJDBC_POOL_RECYCLE=3600

# Pre-ping connections before using them (test if alive)
WBJDBC_POOL_PRE_PING=true

# ========================================
# Connection Settings
# ========================================
# Connection timeout in seconds
WBJDBC_CONNECTION_TIMEOUT=10.0

# Query timeout in seconds
WBJDBC_QUERY_TIMEOUT=30.0

# Maximum number of retry attempts for failed connections
WBJDBC_MAX_RETRIES=3

# Delay between retry attempts in seconds
WBJDBC_RETRY_DELAY=1.0

# Enable automatic reconnection on connection failures
WBJDBC_AUTO_RECONNECT=true

# ========================================
# Batch Execution Settings
# ========================================
# Number of rows per batch for batch operations
WBJDBC_BATCH_SIZE=1000

# Commit after this many rows during batch operations
WBJDBC_BATCH_COMMIT_INTERVAL=5000

# ========================================
# Metadata Cache Settings
# ========================================
# Enable metadata caching (table schemas, columns, etc.)
WBJDBC_CACHE_ENABLED=true

# Cache time-to-live in seconds (how long to cache metadata)
WBJDBC_CACHE_TTL=3600

# Maximum number of cache entries
WBJDBC_CACHE_MAX_SIZE=1000

# ========================================
# Async/Threaded Query Settings
# ========================================
# Enable async query execution
WBJDBC_ASYNC_ENABLED=true

# Maximum number of worker threads for async queries
WBJDBC_ASYNC_MAX_WORKERS=50

# ========================================
# Logging Settings
# ========================================
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
WBJDBC_LOG_LEVEL=INFO

# Log file path (leave empty to log to console only)
WBJDBC_LOG_FILE=

# Log format
WBJDBC_LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s

# Log all SQL queries (can be verbose, use for debugging)
WBJDBC_LOG_SQL_QUERIES=false

# ========================================
# Metrics Settings
# ========================================
# Enable metrics collection
WBJDBC_METRICS_ENABLED=true

# Metrics export file path (leave empty to disable file export)
WBJDBC_METRICS_FILE=

# Enable Prometheus metrics format (for integration with Prometheus/Grafana)
WBJDBC_METRICS_PROMETHEUS=false

# ========================================
# Informix Specific Settings
# ========================================
# Enable dirty reads for Informix (allows reading uncommitted data)
# This provides better performance but may read inconsistent data
WBJDBC_INFORMIX_DIRTY_READS=false

# Default isolation level for Informix connections
# Options: READ_UNCOMMITTED, READ_COMMITTED, REPEATABLE_READ, SERIALIZABLE, DIRTY_READ
WBJDBC_INFORMIX_ISOLATION_LEVEL=READ_COMMITTED

# ========================================
# Security Settings
# ========================================
# Enable SSL/TLS connections (if supported by database)
WBJDBC_SSL_ENABLED=false

# Verify SSL certificates
WBJDBC_SSL_VERIFY=true

# ========================================
# Performance Tuning
# ========================================
# These settings allow you to fine-tune performance based on your workload

# For high-throughput batch operations:
# - Increase BATCH_SIZE to 5000-10000
# - Increase BATCH_COMMIT_INTERVAL to 50000
# - Increase POOL_SIZE and POOL_MAX_SIZE

# For many concurrent queries:
# - Increase POOL_MAX_SIZE to 50-100
# - Increase ASYNC_MAX_WORKERS to 100-200
# - Enable POOL_PRE_PING

# For read-heavy workloads with stable schemas:
# - Enable CACHE_ENABLED
# - Increase CACHE_TTL to 7200 or higher
# - Increase CACHE_MAX_SIZE to 5000+

# For Informix with long-running reports reading historical data:
# - Set INFORMIX_DIRTY_READS=true for better performance
# - Set INFORMIX_ISOLATION_LEVEL=READ_UNCOMMITTED

# ========================================
# Example Configurations
# ========================================

# High-Performance Batch Loading:
# WBJDBC_BATCH_SIZE=10000
# WBJDBC_BATCH_COMMIT_INTERVAL=100000
# WBJDBC_POOL_SIZE=5
# WBJDBC_POOL_MAX_SIZE=10

# High-Concurrency OLTP:
# WBJDBC_POOL_SIZE=20
# WBJDBC_POOL_MAX_SIZE=100
# WBJDBC_ASYNC_MAX_WORKERS=200
# WBJDBC_POOL_PRE_PING=true
# WBJDBC_CACHE_ENABLED=true

# Reporting/Analytics (Informix):
# WBJDBC_INFORMIX_DIRTY_READS=true
# WBJDBC_POOL_SIZE=3
# WBJDBC_POOL_MAX_SIZE=5
# WBJDBC_QUERY_TIMEOUT=300.0
# WBJDBC_CACHE_ENABLED=true
